{
  "name": "@slop/bondi-ski",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "fetch-data": "node tools/fetch-data.mjs",
    "build-course": "node tools/build-course.mjs",
    "export-maps": "node ../tools/export-levels.mjs assets-src/maps public/maps",
    "build-server": "vite build --config server/vite.config.ts",
    "server": "vite build --config server/vite.config.ts && node dist-server/main.js",
    "deploy-server": "cd .. && fly deploy . --config bondi-ski/server/fly.toml --dockerfile bondi-ski/server/Dockerfile --ha=false"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@slop/audio": "workspace:*",
    "@slop/core": "workspace:*",
    "@slop/fps-controller": "workspace:*",
    "@slop/input": "workspace:*",
    "@slop/level-loader": "workspace:*",
    "@slop/physics": "workspace:*",
    "@slop/tuning": "workspace:*",
    "three": "^0.186.1",
    "trystero": "^0.25.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "pngjs": "^7.0.0"
  }
}
